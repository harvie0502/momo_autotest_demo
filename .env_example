# 複製成 .env 後填入自己的 momo 帳密（.env 不會進版控）
MOMO_ACCOUNT=your_account
MOMO_PASSWORD=your_password

# 是否用無頭模式跑。預設 false（開視窗），因為 momo 的 WAF 會擋掉無頭瀏覽器的
# 搜尋建議 API（預檢直接回 403），關鍵字建議清單出不來，測試會失敗。
MOMO_HEADLESS=false

# 用哪個瀏覽器跑。預設本機安裝的 Chrome，這樣才跟手動登入通過簡訊驗證的
# 是同一個瀏覽器身分；留空則改用 Playwright 內建的 Chromium。
MOMO_BROWSER_CHANNEL=chrome

# 有頭模式下，在結帳頁與登出前後各停幾秒，方便人眼確認。設 0 可關閉。
MOMO_HEADED_PAUSE_SEC=3
